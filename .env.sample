# --- LLM: Scaleway Generative APIs -------------------------------------------
# OpenAI-compatible. Store the URL WITHOUT the /v1 suffix; the clients append it.
# This repository uses the LLM_* names. Other services in the workspace use
# VLLM_*, and the shared client reads LLM_* first then falls back to VLLM_*, so
# a script can borrow another service's .env unchanged.
#
# See USING_LLMS.md for the endpoint, the model list and the three quirks that
# will otherwise cost you an afternoon.
LLM_URL=https://api.scaleway.ai/<project-id>
LLM_MODEL=qwen3.5-397b-a17b
LLM_API_KEY=

# MANDATORY for thinking models (any qwen3.5*): without it the model spends its
# whole token budget reasoning and returns content: null - an empty answer, not
# an error. Models that reject the field are handled by the client, which drops
# it on that specific 400 and remembers.
LLM_REASONING_EFFORT=none

# Optional hosted judge for ko_quality_judging. Unset means the endpoint above
# is used instead.
#OPENAI_API_KEY=
#OPENAI_MODEL=

# --- Hugging Face ------------------------------------------------------------
# Needed to download the sentence-transformers models used for local embedding.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# --- Retired -----------------------------------------------------------------
# RunPod pods are gone and their proxy URLs return 403. Do not reintroduce.
#RUNPOD_OLLAMA_HOST=
#OLLAMA_HOST=
