{
  "settings": {
    "analysis": {
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "title_llm": {
        "type": "text",
        "copy_to": "search_text"
      },
      "subtitle_llm": {
        "type": "text",
        "copy_to": "search_text"
      },
      "description_llm": {
        "type": "text",
        "copy_to": "search_text"
      },
      "keywords_llm": {
        "type": "text",
        "copy_to": "search_text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer",
            "ignore_above": 256
          }
        }
      },
      "ko_content_flat_summarised": {
        "type": "text",
        "copy_to": "search_text"
      },
      "ko_content_flat": {
        "type": "text",
        "copy_to": "search_text"
      },
      "project_name": {
        "type": "text",
        "copy_to": "search_text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer",
            "ignore_above": 256
          }
        }
      },
      "ko_object_name": {
        "type": "text",
        "copy_to": "search_text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer",
            "ignore_above": 256
          }
        }
      },
      "search_text": {
        "type": "text"
      },
      "themes": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "subcategories": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "locations_flat": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "languages": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "project_id": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "project_acronym": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "date_of_completion": {
        "type": "date"
      },
      "ko_created_at": {
        "type": "date"
      },
      "ko_updated_at": {
        "type": "date"
      },
      "creators": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "category": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "project_type": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      },
      "license": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer"
      }
    }
  }
}
